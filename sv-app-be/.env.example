# Sao chép file này thành .env và điền các giá trị thực tế của bạn
# cp .env.example .env

# Server
PORT=4000

# MySQL / Database
DATABASE_NAME=sinhviendb
DATABSE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Redis (local)
REDIS_HOST=127.0.0.1

# Redis Cloud (tuỳ chọn, dùng cho môi trường production)
REDIS_CONNECT_URL=your_redis_cloud_url
REDIS_CONNECT_HOST=your_redis_port
REDIS_CONNECT_PASSWORD=your_redis_password

# JWT
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Cloudinary (upload ảnh)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECERT=your_cloudinary_api_secret

# AWS S3
ACCESS_KEY_ID=your_aws_access_key_id
SECRET_ACCESS_KEY=your_aws_secret_access_key
