# Sao chép file này thành .env và điền các giá trị thực tế của bạn
# cp .env.example .env

# Server
PORT=4000

# CORS - danh sách origin được phép, phân cách bằng dấu phẩy
# (FE local + FE production)
CORS_ORIGINS=http://localhost:3000,https://your-fe-domain.com

# MySQL / Database
DATABASE_NAME=sinhviendb
DATABSE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Redis (local)
REDIS_HOST=127.0.0.1

# Redis Cloud (tuỳ chọn, dùng cho môi trường production)
REDIS_CONNECT_URL=your_redis_cloud_url
REDIS_CONNECT_HOST=your_redis_port
REDIS_CONNECT_PASSWORD=your_redis_password

# JWT
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Mật khẩu mặc định khi admin tạo sinh viên mới
DEFAULT_STUDENT_PASSWORD=12345

# Cloudinary (upload ảnh)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECERT=your_cloudinary_api_secret

# AWS S3
ACCESS_KEY_ID=your_aws_access_key_id
SECRET_ACCESS_KEY=your_aws_secret_access_key

# Firebase (xác thực email)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# Gmail SMTP (gửi mail)
MAIL_USER=your_gmail_address
MAIL_PASSWORD=your_gmail_app_password

# MoMo Payment
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_PARTNER_CODE=MOMO
MOMO_REDIRECT_URL=https://your-domain.com/xac-nhan-thanh-toan
MOMO_IPN_URL=your_momo_ipn_webhook_url
